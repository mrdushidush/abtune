{
  "name": "abtune",
  "version": "0.0.0",
  "private": true,
  "description": "A/B test your taste: answer this-or-that questions, get a playlist that sounds like you.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "abtune": "node packages/cli/src/main.ts",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "schema": "node packages/cli/src/main.ts schema --out data/questions/schema.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
