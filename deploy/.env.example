# A public ABTune instance (docs/DEPLOY.md). Copy to deploy/.env.

# The address people open. The app answers to this host name, and share links and link previews
# point here.
APP_BASE_URL=https://abtune.com

# How visitors reach the app: `caddy` (the domain points at this server) or `tunnel` (Cloudflare).
COMPOSE_PROFILES=caddy

# caddy: the site's host name, without www (www redirects to it).
SITE_HOST=abtune.com

# tunnel: from Cloudflare, Zero Trust → Networks → Tunnels → your tunnel → the token in the install
# command.
TUNNEL_TOKEN=

# A published image instead of building from this checkout: ghcr.io/mrdushidush/abtune:latest (the
# latest release) or :main (every push to main). Then `docker compose pull && docker compose up -d`.
# ABTUNE_IMAGE=

# Playlists a minute per visitor (default 20). One vCPU builds about two a second, so this keeps one
# visitor in a loop from taking them all.
# PLAYLISTS_PER_MINUTE=20

# Usage events a minute per visitor (default 30). A quiz sends a handful; the limit keeps a script
# from making up the public counts.
# EVENTS_PER_MINUTE=30

# A public instance keeps AI and Spotify off: AI needs a model server next to it, and Spotify's
# development mode only works for the accounts its owner adds by hand.
AI_PROVIDER=none
