# ABTune configuration. Copy to .env and fill in what you use; the quiz, playlists and export need none of it.
# Variables marked (Mx) are read starting at that milestone.

APP_BASE_URL=http://127.0.0.1:8787
# Host port for `docker compose up` (container always listens on 8787).
ABTUNE_PORT=8787

# Catalog (M1). Leave CATALOG_PATH unset to use the best catalog under ./data/catalog
# (a full build beats the dev sample). Get the dev sample with `abtune catalog fetch`
# or `docker compose run --rm catalog`.
# CATALOG_PATH=./data/catalog/catalog-2026.09
# Where `catalog fetch` downloads the dev sample from (default: the GitHub release).
# CATALOG_SAMPLE_URL=

# Spotify, bring-your-own Client ID (M5). Create an app at https://developer.spotify.com/dashboard
# (steps in docs/SELF_HOSTING.md, or press "Save to Spotify" in the app).
SPOTIFY_CLIENT_ID=
# Exactly as registered in the dashboard. Loopback IP, never "localhost"; https behind a proxy.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback
# Encrypts stored Spotify connections. 32+ random characters, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
TOKEN_ENCRYPTION_KEY=
# Where the encrypted connections live (default data/spotify/tokens.json; shared with the MCP server).
# SPOTIFY_TOKEN_FILE=

# AI layer (M7), off by default
AI_PROVIDER=none            # none | openai_compat | openrouter | anthropic
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_MODEL=
AI_API_KEY=
OPENROUTER_API_KEY=
JEV_ENABLED=false
JEV_MODEL=typesafe/jev-1.13
JEV_WEIGHT=2.0
RERANK_BACKEND=none         # none | llm | jev
ALLOW_SENSITIVE_TO_AI=false
SPICY_PACK_DEFAULT=false
