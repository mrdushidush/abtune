# ABTune configuration. Copy to .env and fill in what you use; the quiz, playlists and export need none of it.
# Variables marked (Mx) are read starting at that milestone.

# Where the app is opened. MCP share links point here, and the web server answers to this host
# name (besides loopback names and IP addresses): set it to a reverse proxy's public URL.
APP_BASE_URL=http://127.0.0.1:8787
# The only folder the MCP server's export_playlist writes to (default: its working directory).
# EXPORT_DIR=
# Host port for `docker compose up` (container always listens on 8787).
ABTUNE_PORT=8787
# Open to the internet: playlists a minute per visitor (unset: no limit; abtune.com uses 20), and
# TRUST_PROXY=true when only your reverse proxy reaches the app (it reads X-Forwarded-For).
# PLAYLISTS_PER_MINUTE=20
# TRUST_PROXY=false

# Catalog. Leave CATALOG_PATH unset to use the best catalog under ./data/catalog
# (a full build beats the dev sample). Get the dev sample with `abtune catalog fetch`
# or `docker compose run --rm catalog`.
# CATALOG_PATH=./data/catalog/catalog-2026.09.2
# Where `catalog fetch` downloads the dev sample from (default: the GitHub release).
# CATALOG_SAMPLE_URL=

# Spotify, bring-your-own Client ID (optional). Create an app at https://developer.spotify.com/dashboard
# (steps in docs/SELF_HOSTING.md, or press "Save to Spotify" in the app).
SPOTIFY_CLIENT_ID=
# Exactly as registered in the dashboard. Loopback IP, never "localhost"; https behind a proxy.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback
# Encrypts stored Spotify connections. 32+ random characters, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
TOKEN_ENCRYPTION_KEY=
# Where the encrypted connections live (default data/spotify/tokens.json; shared with the MCP server).
# SPOTIFY_TOKEN_FILE=

# AI layer, off by default. v0.1 talks to a local OpenAI-compatible server only (steps in
# docs/SELF_HOSTING.md). Base URLs end in /v1. From inside Docker, the host is host.docker.internal:
#   LM Studio  http://127.0.0.1:1234/v1   (Docker: http://host.docker.internal:1234/v1)
#   Ollama     http://127.0.0.1:11434/v1  (Docker: http://host.docker.internal:11434/v1)
#   llama.cpp  http://127.0.0.1:8080/v1   (Docker: http://host.docker.internal:8080/v1)
AI_PROVIDER=none            # none | openai_compat
AI_BASE_URL=http://127.0.0.1:1234/v1
# The model id your server lists at <AI_BASE_URL>/models.
AI_MODEL=
# Only if your server wants a key.
AI_API_KEY=
# Per call, in ms (default 20000).
AI_TIMEOUT_MS=
# For thinking models, e.g. `none` for Qwen 3 in LM Studio (sent as reasoning_effort).
AI_REASONING_EFFORT=
# `llm`: the model also picks the songs from a shortlist and says why (slower; off by default).
RERANK_BACKEND=none         # none | llm
# Lets the setup screen offer a per-session opt-in to send sensitive (e.g. political) answers.
ALLOW_SENSITIVE_TO_AI=false
SPICY_PACK_DEFAULT=false
